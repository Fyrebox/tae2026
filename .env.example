PORT=3000
OPENAI_API_KEY=

# PIN for the live host view at /session1/host ("Rule or AI?" activity). If unset, a random PIN is printed at boot.
HOST_PIN=

# LLM explainer at /how-ai-writes. The chat model must return logprobs:
# gpt-4.1-mini (up to 20 choices shown) or gpt-5.6-luna (only up to 5).
OPENAI_EXPLAINER_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-large

# Shared class schedule. Use the existing Railway Postgres connection.
DATABASE_URL=
# Separate organiser PIN for changing presentation dates and times (at least 6 digits).
SCHEDULE_ADMIN_PIN=
