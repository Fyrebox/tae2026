doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet" href="/styles.css")
    script(src="https://unpkg.com/htmx.org@2.0.4")
    script(defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js")
  body
    header
      a.brand(href="/") TAE Assignments Sign-Up Sheets
      nav
        a(href="/calendar") Calendar
        a(href="/courses/new") + Post a course
    main
      block content
    script.
      function formatLocalTimes(root) {
        (root || document).querySelectorAll('time[data-iso]').forEach(function(el) {
          var d = new Date(el.dataset.iso);
          if (isNaN(d.getTime())) return;
          var fmt = el.dataset.fmt || 'datetime';
          if (fmt === 'time') {
            el.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          } else {
            el.textContent = d.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
          }
        });
      }
      formatLocalTimes();
      document.body.addEventListener('htmx:afterSwap', function(e) { formatLocalTimes(e.target); });
