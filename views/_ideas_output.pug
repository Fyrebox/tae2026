if errorMessage
  .error-banner= errorMessage
else if ideas && ideas.length
  h2 Suggested courses
  .idea-cards
    each idea in ideas
      article.idea-card
        h3= idea.title
        p.idea-blurb= idea.blurb
        if idea.participant_task
          p.idea-task
            strong Participant task:
            |
            span= ' ' + idea.participant_task
        p.idea-why
          strong Why 30 min?
          |
          span= ' ' + idea.why_30_min
else if ideas
  p.empty No ideas came back. Try a different skill set.
