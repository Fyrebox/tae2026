extends layout
include mixins

block content
  a.back(href="/") ← All courses
  .title-row
    h1= course.title
    a.edit-link(href=`/courses/${course.id}/edit`) Edit
  if warnings && warnings.length
    .warning-banner
      strong Heads up:
      ul
        each w in warnings
          li= w
  p.meta
    strong= course.presenter
    if course.contact
      |
      span.contact= course.contact
  if course.scheduled_at
    - var iso1 = new Date(course.scheduled_at).toISOString()
    p.schedule
      span.schedule-icon 🗓
      span.schedule-label 1st:
      |
      time(datetime=iso1 data-iso=iso1)
      span.schedule-duration  · 30 min
  if course.scheduled_at_2
    - var iso2 = new Date(course.scheduled_at_2).toISOString()
    p.schedule
      span.schedule-icon 🗓
      span.schedule-label 2nd:
      |
      time(datetime=iso2 data-iso=iso2)
      span.schedule-duration  · 30 min
      if course.title_2
        |
        span.schedule-subtitle= course.title_2
  if course.meeting_link
    p.meeting
      a.join-link(href=course.meeting_link target="_blank" rel="noopener noreferrer") Join meeting
  if course.description
    p.description= course.description

  section
    h2
      | Attendees
      |
      small (#{attendees.length})

    form(
      hx-post=`/courses/${course.id}/attendees`
      hx-target="#attendees"
      hx-swap="outerHTML"
      hx-on::after-request="if(event.detail.successful) this.reset()"
    )
      input(type="text" name="name" placeholder="Your name" required maxlength="80")
      button(type="submit") Enrol

    +attendeesBlock(course.id, attendees)
