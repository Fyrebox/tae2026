extends layout

block content
  h1 Need ideas?
  p.lede Enter the skills you have and we'll suggest beginner-friendly 30-minute course ideas you could teach.

  form.stack(
    method="post"
    action="/ideas"
    hx-post="/ideas"
    hx-target="#ideas-output"
    hx-swap="innerHTML"
    hx-indicator="#ideas-spinner"
    x-data="{ submitting: false }"
    "@htmx:before-request"="submitting = true"
    "@htmx:after-request"="submitting = false"
  )
    label
      | Your skills
      textarea(
        name="skills"
        rows="3"
        maxlength="500"
        required
        placeholder="hairdressing, nursing, accounting…"
      )= skills || ''
    .form-actions
      span#ideas-spinner.htmx-indicator Generating ideas…
      button(
        type="submit"
        ":disabled"="submitting"
        "x-text"="submitting ? 'Generating…' : 'Suggest ideas'"
      ) Suggest ideas

  section#ideas-output
    include _ideas_output
