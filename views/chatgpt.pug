extends layout

block content
  h1 Ask ChatGPT
  p.lede Enter a prompt and OpenAI will answer it.

  form.stack(
    method="post"
    action="/chatgpt"
    hx-post="/chatgpt"
    hx-target="#chatgpt-output"
    hx-swap="innerHTML"
    hx-indicator="#chatgpt-spinner"
    x-data="{ submitting: false }"
    "@htmx:before-request"="submitting = true"
    "@htmx:after-request"="submitting = false"
  )
    label
      | Your prompt
      textarea(
        name="prompt"
        rows="5"
        maxlength="2000"
        required
        placeholder="Ask anything…"
      )= prompt || ''
    .form-actions
      span#chatgpt-spinner.htmx-indicator Thinking…
      button(
        type="submit"
        ":disabled"="submitting"
        "x-text"="submitting ? 'Thinking…' : 'Ask'"
      ) Ask

  section#chatgpt-output
    include _chatgpt_output
