extends layout

block content
  h1 Create a new Online Course
  form.stack#new-form(
    method="post"
    action="/courses"
    x-data="{ submitting: false }"
    @submit="submitting = true"
  )
    label
      | Title
      input(type="text" name="title" required maxlength="120")
    label
      | Presenter (your name)
      input(type="text" name="presenter" required maxlength="80")
    label
      | Contact (email or phone)
      input(type="text" name="contact" required maxlength="120" placeholder="you@example.com or 04xx xxx xxx")
    label
      | First session (optional, 30 min)
      input(type="datetime-local" name="scheduled_at")
    label
      | Second session (optional, 30 min)
      input(type="datetime-local" name="scheduled_at_2")
    label
      | Second session title (optional)
      input(type="text" name="title_2" maxlength="120")
    label
      | Meeting link (optional)
      input(type="url" name="meeting_link" maxlength="500" placeholder="https://zoom.us/j/...")
    label
      | Description
      textarea(name="description" rows="4" maxlength="1000")
    .form-actions
      a.cancel-link(href="/") Cancel
      button(
        type="submit"
        ":disabled"="submitting"
        "x-text"="submitting ? 'Posting…' : 'Post course'"
      ) Post course

  script.
    document.getElementById('new-form').addEventListener('submit', function() {
      this.querySelectorAll('input[type="datetime-local"]').forEach(function(input) {
        if (!input.value) return;
        var d = new Date(input.value);
        if (isNaN(d.getTime())) return;
        input.value = d.toISOString();
      });
    }, { capture: true });
